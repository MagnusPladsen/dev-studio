# Cloud sync & sign-in (optional). Without these the app runs fully local
# (browser storage, or a folder on your disk via "Connect folder").
#
# Find both in Supabase: Project Settings → API (or "Connect" → App frameworks → Next.js).
# The Vercel ↔ Supabase integration sets them for you automatically.
NEXT_PUBLIC_SUPABASE_URL=https://lznqrdbvamheoisjaoqr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Which app to build: "dev-studio" for Dev Studio (Task Board, Canvas, Wiki, Notebook),
# unset for GameDev Studio (every tool). Set it per Vercel project.
# NEXT_PUBLIC_APP=dev-studio
